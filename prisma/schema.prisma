generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id            String   @id @default(uuid())
  name          String
  game          String
  format        String
  region        String
  city          String?
  startDate     String
  endDate       String
  startTime     String?
  status        String   @default("upcoming")
  playersCount  Int      @default(0)
  description   String
  bannerUrl     String?
  organizerName String
  sourceUrl     String?
  featured      Boolean  @default(false)
  requestId     String?  @unique
  discordEventId String?
  createdAt     DateTime @default(now())
}

model User {
  id                       String   @id @default(uuid())
  email                    String   @unique
  password                 String
  name                     String?
  role                     String   @default("admin")
  notifyOnRequests         Boolean  @default(false)
  telegramChatId           String?
  tournamentTelegramChatId String?
  authTelegramChatId       String?  @unique
  createdAt                DateTime @default(now())
}

model TournamentRequest {
  id        String   @id @default(uuid())
  name      String
  url       String?
  comment   String?
  startDate String
  endDate   String
  startTime String?
  region    String
  city      String?
  game      String
  format    String   @default("offline")
  bannerUrl String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Player {
  id                String   @id @default(uuid())
  tag               String
  realName          String?
  country           String
  region            String
  mainGame          String
  avatarUrl         String?
  tournamentsPlayed Int      @default(0)
  wins              Int      @default(0)
  top3              Int      @default(0)
  points            Int      @default(0)
  discord           String?
  twitter           String?
  twitch            String?
  challongeUsername String?  @unique
  createdAt         DateTime @default(now())
}

model ChallongeApiUsage {
  id    String @id @default(uuid())
  month String @unique
  count Int    @default(0)
}

model Game {
  id         String   @id @default(uuid())
  key        String   @unique
  label      String
  shortLabel String?
  color      String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model BacklogItem {
  id        String   @id @default(uuid())
  text      String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model RequestSubmission {
  id        String   @id @default(uuid())
  kind      String   @default("tournament_request")
  ip        String
  createdAt DateTime @default(now())

  @@index([kind, ip, createdAt])
}

model AppSetting {
  key   String @id
  value String
}

model SubscriptionLog {
  id                String   @id @default(uuid())
  userEmail         String
  tournamentName    String
  offset            String
  tournamentStartAt String
  createdAt         DateTime @default(now())
}

model TournamentReminder {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  offset       String
  sent         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([tournamentId, userId, offset])
}

model ExportLog {
  id           String   @id @default(uuid())
  platform     String
  serverId     String
  successCount Int      @default(0)
  failCount    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([platform, createdAt])
}
