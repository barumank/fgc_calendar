generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id            String   @id @default(uuid())
  name          String
  game          String
  format        String
  region        String
  country       String
  city          String
  startDate     String
  endDate       String
  status        String   @default("upcoming")
  prizePool     String
  playersCount  Int      @default(0)
  description   String
  bannerUrl     String?
  organizerName String
  sourceUrl     String?
  bracketUrl    String?
  featured      Boolean  @default(false)
  requestId     String?  @unique
  createdAt     DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model TournamentRequest {
  id        String   @id @default(uuid())
  name      String
  url       String?
  comment   String?
  startDate String
  endDate   String
  region    String
  game      String
  format    String   @default("offline")
  bannerUrl String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Player {
  id                String   @id @default(uuid())
  tag               String
  realName          String?
  country           String
  region            String
  mainGame          String
  avatarUrl         String?
  tournamentsPlayed Int      @default(0)
  wins              Int      @default(0)
  top3              Int      @default(0)
  points            Int      @default(0)
  discord           String?
  twitter           String?
  twitch            String?
  challongeUsername String?  @unique
  createdAt         DateTime @default(now())
}

model ChallongeApiUsage {
  id    String @id @default(uuid())
  month String @unique
  count Int    @default(0)
}

model Game {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  color     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
